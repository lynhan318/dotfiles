// Layout sizing. Color values live in colors.kdl.

layout {
    gaps 4

    border {
        width 2
    }

    focus-ring {
        width 2
    }

    // Fallback presets. Both current screens override these in
    // displays-generated.kdl — a third of the 1714 px laptop panel is 571 px,
    // which is too narrow to work in, while the 2560 px Samsung wants thirds —
    // so what is left here is what an unrecognised monitor gets.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // A lone column sits centred rather than pinned to the left edge. No-op on
    // any output whose default column width is 1.0.
    always-center-single-column

    // Tab indicator. The default 4 px strip is a hard mouse target -- the only
    // pointer gesture niri puts on it is interactive resize (drag it to resize
    // the column), and 4 px is thinner than most people can hit on purpose.
    //
    // width is the thickness; length is how far it runs along the column, and
    // the default total-proportion=0.5 covers only half the window height, so
    // widening alone would still leave half the edge dead. Both are raised.
    tab-indicator {
        width 12
        length total-proportion=1.0
        gap 5
        gaps-between-tabs 2
        corner-radius 0
    }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

recent-windows {
    highlight {
        corner-radius 12
    }
}
