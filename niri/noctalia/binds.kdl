binds { // === System & Overview ===
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Tab repeat=false { toggle-overview; }
    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "ghostty"; }

    // --- Noctalia shell (IPC via `noctalia msg`) ---
    // Default application launcher: Vicinae (https://vicinae.com).
    // Server runs via the `vicinae.service` systemd user unit.
    Mod+D hotkey-overlay-title="Application Launcher (Vicinae)" {
        spawn "vicinae" "toggle";
    }
    // Vicinae keeps its own clipboard history (~/.local/share/vicinae/clipboard.db),
    // so this is its built-in `clipboard:history` command rather than Noctalia's
    // panel. `vicinae cmd ls` lists the ids; `clipboard:clear-history` is the
    // other useful one.
    Mod+V hotkey-overlay-title="Clipboard History" {
        spawn "vicinae" "cmd" "launch" "clipboard:history";
    }
    Mod+A hotkey-overlay-title="Control Center" {
        spawn "noctalia" "msg" "panel-toggle" "control-center";
    }
    Mod+M hotkey-overlay-title="Session / Power Menu" {
        spawn "noctalia" "msg" "panel-toggle" "session";
    }
    Mod+N hotkey-overlay-title="Notification Center" {
        spawn "noctalia" "msg" "panel-toggle" "notifications";
    }
    Mod+Comma hotkey-overlay-title="Settings" {
        spawn "noctalia" "msg" "settings-toggle";
    }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn "noctalia" "msg" "panel-toggle" "wallpaper";
    }
    // Was `noctalia msg screenshot-region`, which also just copied and left no
    // way to mark anything up. Same script as Print below, so every screenshot
    // chord ends in the editor.
    Mod+S hotkey-overlay-title="Screenshot region" {
        spawn-sh "~/.dotfiles/niri/scripts/screenshot-edit.sh region";
    }
    Mod+E hotkey-overlay-title="Open Files" {
        spawn "nautilus";
    }
    Mod+C hotkey-overlay-title="Open Browser" {
        spawn "google-chrome-stable";
    }
    Mod+Shift+C hotkey-overlay-title="Cast focused window" {
        spawn-sh "niri msg action set-dynamic-cast-window --id $(niri msg -j focused-window | jq .id)";
    }
    Mod+G hotkey-overlay-title="Toggle screen recording" {
        spawn "noctalia" "msg" "plugin" "noctalia/screen_recorder:service" "all" "toggle";
    }

    // Noctalia has no IPC color-picker / notepad / process-list equivalent.
    // Re-enable these with an external tool if you want them:
    // Mod+P hotkey-overlay-title="Color Picker" { spawn-sh "hyprpicker -a"; }

    // === Security ===
    Mod+Ctrl+L hotkey-overlay-title="Lock Screen" {
        spawn "noctalia" "msg" "session" "lock";
    }
    Mod+Shift+E { quit; }

    // === Audio Controls (Noctalia OSD) ===
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-up" "3";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-down" "3";
    }
    XF86AudioMute allow-when-locked=true {
        spawn "noctalia" "msg" "volume-mute";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn "noctalia" "msg" "mic-mute";
    }

    // === Media Controls ===
    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }

    // === Brightness Controls ===
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-up";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-down";
    }

    // === Window Management ===
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Space { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // === Focus Navigation ===
    // hjkl works the same in the overview (Mod+Tab) as it does normally —
    // niri's overview is not a separate mode, so these binds stay live and the
    // zoomed-out view follows the focus.
    //
    // J/K fall through to the neighbouring workspace once you hit the bottom /
    // top of a column, so you can hold j to walk down through everything.
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }

    // === Window Movement ===
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // === Column Navigation ===
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // === Monitor Navigation ===
    // Mod+` cycles monitors — with two screens it is simply "the other one",
    // and it keeps working whether they are side by side or stacked, unlike the
    // directional binds below.
    Mod+grave repeat=false hotkey-overlay-title="Focus Other Monitor" { focus-monitor-next; }
    Mod+Shift+grave repeat=false { focus-monitor-previous; }

    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }

    // === Move to Monitor ===
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // === Workspace Navigation ===
    // U/I jump a whole workspace regardless of where you are in a column —
    // the focus counterpart of the Ctrl+U/I "move column to workspace" pair
    // below. Handy in the overview for hopping straight between workspaces.
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+Down      { focus-workspace-down; }
    Mod+Up        { focus-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // === Move Workspaces ===
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // === Mouse Wheel Navigation ===
    Mod+WheelScrollDown      { focus-column-right; }
    Mod+WheelScrollUp       { focus-column-left; }

    // === Numbered Workspaces ===
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // === Move to Numbered Workspaces ===
    // Per-output, mirroring Mod+1..4 above: the column lands on workspace N of
    // the screen it is already on, rather than being thrown to another monitor.
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // === Column Management ===
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }

    // === Sizing & Layout ===
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Ctrl+C { center-visible-columns; }
    // Mod+C { center-column; }

    // === Manual Sizing ===
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // === Screenshots ===
    // niri still draws the picker — the script only passes --path so the shot
    // lands somewhere it can hand to satty, rather than being copied and
    // forgotten. See ../scripts/screenshot-edit.sh.
    XF86Launch1 { spawn-sh "~/.dotfiles/niri/scripts/screenshot-edit.sh region"; }
    Ctrl+XF86Launch1 { spawn-sh "~/.dotfiles/niri/scripts/screenshot-edit.sh screen"; }
    Mod+XF86Launch1 { spawn-sh "~/.dotfiles/niri/scripts/screenshot-edit.sh window"; }
    Print { spawn-sh "~/.dotfiles/niri/scripts/screenshot-edit.sh region"; }
    Ctrl+Print { spawn-sh "~/.dotfiles/niri/scripts/screenshot-edit.sh screen"; }
    Mod+Print { spawn-sh "~/.dotfiles/niri/scripts/screenshot-edit.sh window"; }

    // === System Controls ===
    Mod+Shift+P { power-off-monitors; }
}
