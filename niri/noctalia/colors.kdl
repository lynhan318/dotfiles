// Niri border / focus-ring colors for the Noctalia session.
//
// Noctalia does NOT auto-generate this file — these are static Everforest
// values. If you want Noctalia to drive these from the active wallpaper
// palette, add a niri template under
// Noctalia Settings -> Templates that writes this file, then run
// `noctalia msg templates-apply`.

layout {
    background-color "transparent"

    focus-ring {
        active-color   "#a7c080"
        inactive-color "#9da9a0"
        urgent-color   "#e57e80"
    }

    border {
        active-color   "#a7c080"
        inactive-color "#9da9a0"
        urgent-color   "#e57e80"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        // Draw inside the column. The default outside-left placement sits at
        // x = gaps - gap - width = 4 - 5 - 4 = -5 for the leftmost column, i.e.
        // entirely off-screen, so its indicator never appeared.
        place-within-column
        active-color   "#a7c080"
        inactive-color "#9da9a0"
        urgent-color   "#e57e80"
    }

    insert-hint {
        color "#a7c08080"
    }
}

recent-windows {
    highlight {
        active-color   "#a7c080"
        urgent-color   "#e57e80"
    }
}
