// ============================================================================
//  niri + Noctalia
// ----------------------------------------------------------------------------
//  The one and only niri config. ~/.config/niri is a symlink to this folder,
//  so niri loads this file directly. The shell is Noctalia
//  (https://noctalia.dev); the old DankMaterialShell setup has been removed.
//
//  Shell-specific and machine-specific bits live in noctalia/*.kdl (see the
//  includes at the bottom) — see noctalia/README.md.
//
//  KDL format: https://kdl.dev   |   niri wiki: https://github.com/YaLTeR/niri/wiki
// ============================================================================
gestures {
    hot-corners {
        off
    }
}

input {
    mod-key "Alt"

    // Mod+` switches monitors; without this the pointer stays behind on the
    // old screen. center-xy moves it toward the middle of the newly focused
    // window rather than the nearest edge. Drop this line if the cursor
    // jumping around during keyboard navigation is more annoying than useful.
    warp-mouse-to-focus mode="center-xy"
    keyboard {
        xkb {
            // Caps Lock acts as an extra Ctrl (no Caps Lock toggle at all).
            options "ctrl:nocaps"
        }
        repeat-delay 280
        repeat-rate 40
        numlock
    }
    // Tuned to feel like a macOS trackpad. The four settings that actually
    // matter for that are click-method, natural-scroll, accel-profile and
    // scroll-factor; the rest is polish.
    touchpad {
        // Tap-to-click, and the gesture map macOS uses: 1 finger = left,
        // 2 = right, 3 = middle. Without `tap` a two-finger tap does nothing.
        tap
        tap-button-map "left-right-middle"

        // macOS has no click zones — the whole surface is one button and a
        // two-finger press is the right click. That is exactly clickfinger.
        // (libinput's default, button-areas, reserves the bottom-right corner
        // instead, which is the non-Mac feel.)
        click-method "clickfinger"

        // Content follows the fingers, as on macOS.
        natural-scroll
        scroll-method "two-finger"

        // Pointer feel. "adaptive" is the accelerating curve — slow fingers
        // stay precise, fast fingers cross the screen — which is what macOS
        // does; "flat" is 1:1 and feels dead by comparison. accel-speed is
        // -1..1 around the default of 0; a small positive value matches the
        // shorter travel a Mac needs. 0.3 read as too fast on this 132 mm pad,
        // so this sits at libinput's neutral default; nudge in 0.05 steps.
        accel-profile "adaptive"
        accel-speed 0.0

        // Scrolling is already pixel-precise; this only scales the distance.
        // Below 1.0 it takes more finger to move the same content, which is
        // what makes it feel smooth rather than jumpy.
        scroll-factor 0.6

        // Tap, then tap-and-hold to drag — and drag-lock keeps the drag alive
        // across a finger lift, so a long drag can be done in several strokes.
        drag true
        drag-lock

        // Palm rejection while typing, including after the trackpad's own
        // physical click (dwtp). Note these only cover typing and clicking —
        // a hand resting on the edge *while scrolling* is not their job.
        // That case is handled one layer down, in
        // ../system/libinput/local-overrides.quirks, because this pad's
        // firmware retracts its own palm flag mid-gesture and libinput
        // believes it. niri has no palm knob of its own.
        dwt
        dwtp
    }
    mouse {
    }
    trackpoint {
    }
}

// Draw Noctalia's wallpaper into niri's backdrop, so the overview (Mod+Tab)
// shows the wallpaper behind the workspace thumbnails instead of a flat color.
// Verify the namespace with `niri msg layers` if a Noctalia update renames it.
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}

// Background blur, new in niri 26.04. This block is tuning only — blur is
// opt-in per window/layer rule below, via `background-effect`. The values are
// niri's own defaults, spelled out so they are visible to tune: `passes` and
// `offset` together set the radius, `noise` hides banding, `saturation` lifts
// the colour of what shows through.
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.5
}

// Noctalia draws its bars and panels at background_opacity 0.88, so there is
// something to see through and blur is worth paying for.
//
// The namespaces are matched exactly, not by a `^noctalia-` prefix, because two
// of its surfaces must NOT be blurred: `noctalia-wallpaper` is the wallpaper
// itself (see above), and `noctalia-panel-click-shield` is a transparent
// full-screen click catcher — blurring that one would blur the whole screen.
//
// Add `xray true` here to sample the wallpaper instead of the live scene. It is
// much cheaper, but a bar sitting over a window would then show blurred
// wallpaper rather than the window, so it is off by default.
layer-rule {
    match namespace="^noctalia-bar-"
    match namespace="^noctalia-panel$"
    background-effect {
        blur true
    }
}
overview {
    // Fallback color, visible only where the wallpaper layer isn't drawn (e.g.
    // an output Noctalia hasn't painted yet). Opaque so niri clears the
    // backdrop buffer each frame — a transparent value leaves ghost images of
    // old windows behind the wallpaper.
    backdrop-color "#2d353b"
    workspace-shadow {
        off
    }
}

// === Startup ===
spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"
spawn-at-startup "fcitx5"
spawn-at-startup "noctalia" "--daemon"
spawn-at-startup "vicinae" "server"

environment {
  XDG_CURRENT_DESKTOP "niri"
  GTK_IM_MODULE ""
}
hotkey-overlay {
    skip-at-startup
}

// Workspaces 1-4 live on the main screen (Samsung); the Yoga panel holds
// exactly one, workspace 5. niri falls back to the only connected output when
// the Samsung is unplugged.
//
// Note: open-on-output only applies when a workspace is first created, so
// reordering these takes effect on the next niri restart — a config reload
// leaves already-open workspaces where they are.
workspace "1: dev" {
    open-on-output "Samsung Electric Company LS27D80xU HNAX900140"
}
workspace "2: web" {
    open-on-output "Samsung Electric Company LS27D80xU HNAX900140"
}
workspace "3: message" {
    open-on-output "Samsung Electric Company LS27D80xU HNAX900140"
}
workspace "4: misc" {
    open-on-output "Samsung Electric Company LS27D80xU HNAX900140"
}
workspace "5: float" {
    open-on-output "eDP-1"
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

// === Window rules ===
window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 0
    clip-to-geometry true
}
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}
window-rule {
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^steam$"#
    match app-id=r#"^xdg-desktop-portal$"#
    match app-id=r#"^1password$"#
    match app-id=r#"^telegram-desktop$"#
    match app-id=r#"^slack$"#
    match app-id=r#"^Pinentry-gtk"#
    match app-id=r#"^org.telegram.desktop"#
    match app-id=r#"^Emulator"#
    match app-id=r#"^Slack"#
    match app-id=r#"^chrome-kjgfgldnnfoeklkmfkjfagphfepbbdan-Profile_1"#
    open-floating true
}

// The screenshot annotator (see scripts/screenshot-edit.sh). It is a shutter
// confirmation rather than a window to manage — it opens, gets marked up, and
// closes on the first save — so tiling it would reshuffle the column layout
// for a couple of seconds every screenshot.
//
// Sized explicitly because satty otherwise asks for a window as large as the
// image, which for a full 3840x2160 shot is the whole screen.
window-rule {
    match app-id=r#"^com\.gabm\.satty$"#
    open-floating true
    default-column-width { proportion 0.75; }
    default-window-height { proportion 0.75; }
}

// Chat apps always open on workspace 4
window-rule {
    match app-id=r#"^telegram-desktop$"#
    match app-id=r#"^org\.telegram\.desktop$"#
    match app-id=r#"^Slack$"#
    match app-id=r#"^slack$"#
    match app-id=r#"^discord$"#
    match app-id=r#"^Discord$"#
    open-on-workspace "3: message"
}
window-rule {
    match app-id="com.mitchellh.ghostty"
    draw-border-with-background false
}

// === Opt-in window behaviour by app-id convention ===
//
// Anything launched with an app-id of `local.<behaviour>.<name>` gets that
// behaviour, so a bar button, launcher entry or one-off script can ask for it
// without earning its own window-rule here:
//
//     ghostty --class=local.maximized.herdr  -e some-command
//     ghostty --class=local.fullscreen.btop  -e btop
//     ghostty --class=local.floating.terminal
//
// Both halves of the shape are load-bearing. The `local.` prefix plus a
// trailing name is what makes it a valid app-id at all — GTK requires at least
// one dot and silently drops a bare word like "fullscreen", leaving the window
// with the app's normal id and no rule match to show for it. The trailing name
// keeps windows distinguishable from each other for anything more specific.
//
// Terminals mostly spell this --class; check the app if it differs.
window-rule {
    match app-id=r#"^local\.maximized\."#
    open-maximized true
}
window-rule {
    match app-id=r#"^local\.fullscreen\."#
    open-fullscreen true
}
window-rule {
    match app-id=r#"^local\.floating\."#
    open-floating true
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}

debug {
    honor-xdg-activation-with-invalid-serial
}

// The Alt-Tab switcher (niri 25.11+).
//
// Nothing here may collide with a chord in the main `binds` block: regular
// binds take priority over recent-windows binds, and niri does NOT warn about
// it — the config validates and the switcher just never opens. That is exactly
// what used to happen here. `mod-key "Alt"` makes Mod == Alt, so the old
// `Mod+Tab { toggle-overview; }` *was* Alt+Tab and swallowed next-window,
// leaving only the Shift direction working. The overview now lives on
// Mod+Escape (binds.kdl) so both directions are reachable again.
//
// Mod+grave is the monitor switcher, so the default Alt+grave app-id cycling
// bind is deliberately not restored.
recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-gradient from="#f38ba8ee" to="#cc241dee" angle=45
    }
}
window-rule {
    match app-id=r#"^1password$"#
    block-out-from "screencast"
}

// === Includes ===
include "noctalia/colors.kdl"
include "noctalia/layout.kdl"
include "noctalia/binds.kdl"
include "noctalia/cursor.kdl"
include "noctalia/windowrules.kdl"

include "noctalia.kdl"

// Output geometry — written by the Noctalia "displays" plugin, which keys each
// monitor by its make/model/serial so a dock renaming the connector (DP-2 one
// day, HDMI-A-1 the next) does not lose its settings.
//
// This is the ONLY place outputs are configured. niri resolves an output with
// `.iter().find()` — the first matching block wins outright and later ones are
// ignored, never merged — so a second hand-written block for the same monitor
// would silently shadow everything here, not add to it.
//
// optional=true (niri 26.04) because the file does not exist until the plugin
// has saved once, e.g. on a fresh clone.
include optional=true "displays-generated.kdl"
